# Application triage provider: mock or openai_compatible
TRIAGE_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=replace-with-provider-model
AI_API_KEY=replace-with-real-key
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2

# JSON array of local reviewer credentials; replace placeholder values and keep .env untracked.
REVIEWER_CREDENTIALS_JSON=[{"username":"support-reviewer","token":"replace-with-random-token","role":"support-reviewer"}]

# Separate, fixed model-based semantic evaluator; do not substitute the application mock.
SEMANTIC_EVALUATOR_BASE_URL=https://api.openai.com/v1
SEMANTIC_EVALUATOR_MODEL=replace-with-pinned-evaluator-model
SEMANTIC_EVALUATOR_API_KEY=replace-with-real-key
SEMANTIC_EVALUATOR_TIMEOUT_SECONDS=30
SEMANTIC_EVALUATOR_RUBRIC_VERSION=1

DATABASE_PATH=./data/triage.sqlite3
